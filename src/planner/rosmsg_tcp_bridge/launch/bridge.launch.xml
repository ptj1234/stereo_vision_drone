<launch>

  <arg name="drone_id" default="1" />

  <!-- <node pkg="rosmsg_tcp_bridge" name="drone_$(var drone_id)_bridge_node" exec="bridge_node" output="screen" launch-prefix="valgrind" > -->
  <node pkg="rosmsg_tcp_bridge" name="drone_$(var drone_id)_bridge_node" exec="bridge_node" output="screen" >
    <remap from="position_cmd" to="drone_$(var drone_id)_planning/pos_cmd"/>
    <remap from="planning/bspline" to="drone_$(var drone_id)_planning/bspline"/>
    <remap from="~/my_odom" to="/vins_fusion/imu_propagate"/>

    <param name="next_drone_ip" value="127.0.0.1"/>
    <param name="broadcast_ip" value="127.0.0.255"/>
    <param name="drone_id" value="$(var drone_id)"/>
    <param name="odom_max_freq" value="70"/>

  </node>

</launch>
